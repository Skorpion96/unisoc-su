#!/system/bin/sh

main() {
    BR_IN="/sdcard/rootbridge/in/command.txt"
    BR_OUT="/sdcard/rootbridge/out/result.txt"
    BANNED_CMDS="if fi else elif then while do done for until case esac select in function continue break logout return trap unset"
    DANGEROUS_PATTERNS="\` <( >| &"

    usage() {
      cat <<EOF >&2
Usage:
  ghostroot -c <command>   # run a single root command
  ghostroot                # enter interactive ghostroot shell
  <exit>                   # exits the rootbridge.sh
  <q>                      # exits the ghostroot, you can always enter again and resume
  <help>                   # Show this help message
EOF
}

    is_dangerous_command() {
        cmd="$1"

        first_word=$(echo "$cmd" | awk '{print $1}' | cut -d'=' -f1)
        for banned in $BANNED_CMDS; do
            if [ "$first_word" = "$banned" ]; then
                return 0
            fi
        done
        
        case "$cmd" in
            *\`*|*"<("*|*">|"*)
                return 0
                ;;
            *"&"*)
                case "$cmd" in
                    *"&&"*|*"&>"*) 
                        ;;
                    *)
                        if echo "$cmd" | grep -qE '[a-zA-Z0-9][[:space:]]*&[[:space:]]*$'; then
                            :
                        else
                            return 0
                        fi
                        ;;
                esac
                ;;
        esac
        
        paren_open=$(echo "$cmd" | tr -cd '(' | wc -c)
        paren_close=$(echo "$cmd" | tr -cd ')' | wc -c)
        brace_open=$(echo "$cmd" | tr -cd '{' | wc -c) 
        brace_close=$(echo "$cmd" | tr -cd '}' | wc -c)
        bracket_open=$(echo "$cmd" | tr -cd '[' | wc -c)
        bracket_close=$(echo "$cmd" | tr -cd ']' | wc -c)
        single_quotes=$(echo "$cmd" | tr -cd "'" | wc -c)
        double_quotes=$(echo "$cmd" | tr -cd '"' | wc -c)
        
        if [ "$paren_open" -ne "$paren_close" ]; then
            return 0
        fi
        if [ "$brace_open" -ne "$brace_close" ]; then
            return 0  
        fi
        if [ "$bracket_open" -ne "$bracket_close" ]; then
            return 0
        fi
        if [ $((single_quotes % 2)) -ne 0 ]; then
            return 0
        fi
        if [ $((double_quotes % 2)) -ne 0 ]; then
            return 0
        fi
        
        case "$cmd" in
            *'$(('*|*'))'*|*'$['*|*']'*|*'${#'*|*'${!'*|*'${'*)
                return 0 ;;
            *"'"*";"*|*";"*"'"*|*'&>'*|*'<<<'*)
                return 0 ;;
        esac
        
        if echo "$cmd" | grep -q '[!]' && ! echo "$cmd" | grep -qE '(\$\([^\)]*\)|"[^"]*![^"]*")'; then
            return 0
        fi
        
        # IMPROVED SEMICOLON VALIDATION (single set of rules)
        case "$cmd" in
            ";")
                # Isolated semicolon - dangerous
                return 0
                ;;
            *" ; "*|*" ;"*)
                # Only block semicolon with space before AND after, or trailing space after semicolon
                return 0
                ;;
            *";;"*)
                # Double semicolon - dangerous
                return 0
                ;;
        esac
        
        # ADDED: Check for semicolon followed directly by alphanumeric (command injection)
        if echo "$cmd" | grep -qE ';[a-zA-Z0-9]'; then
            # Patterns like ;id ;whoami ;cat etc. (semicolon starting a command)
            return 0
        fi
        
        # ADDED: Check for semicolon with dots patterns
        if echo "$cmd" | grep -qE '(;\.+|\.+;)'; then
            # Patterns like ;. .; ...; ;.. etc.
            return 0
        fi
        
        # ADDED: Check for multiple dots (potential directory traversal when combined with other chars)
        if echo "$cmd" | grep -qE '\.{3,}'; then
            # Three or more consecutive dots
            return 0
        fi
        
        # ADDED: Check for semicolon followed by space and special chars
        if echo "$cmd" | grep -qE '; [\.!/\\\]'; then
            # Semicolon followed by space and potentially dangerous chars
            return 0
        fi

        # SEMICOLON + REDIRECT VALIDATION (fixed variable name)
        # Check for semicolon followed by redirect operators
        if echo "$cmd" | grep -qE ';[<>]'; then
            # Patterns like ;> ;< ;<< ;>> etc.
            return 0
        fi
        
        # Check for redirect operators followed by semicolon
        if echo "$cmd" | grep -qE '[<>];'; then
            # Patterns like >; <; >>; <<; etc.
            return 0
        fi
        
        # Check for multiple redirect-semicolon combinations
        if echo "$cmd" | grep -qE '([<>];|;[<>]){2,}'; then
            # Multiple occurrences of these patterns
            return 0
        fi
        
        # ENHANCED PIPE VALIDATION (fixed variable name)
        # Check for pipes followed by non-alphanumeric characters (except valid pipe combinations)
        if echo "$cmd" | grep -qE '\|[^a-zA-Z0-9 ]'; then
            # Pipe followed by special characters like |. |, |: |; |/ etc.
            return 0
        fi
        
        # Check for pipes preceded by non-alphanumeric characters (except valid combinations)
        if echo "$cmd" | grep -qE '[^a-zA-Z0-9 ]\|'; then
            # Special characters followed by pipe like .| ,| :| ;| /| etc.
            return 0
        fi
        
        # Check for multiple consecutive pipes (more than 2)
        if echo "$cmd" | grep -qE '\|{3,}'; then
            # Three or more consecutive pipes
            return 0
        fi
        
        # Check for pipes with only punctuation/symbols around them
        if echo "$cmd" | grep -qE '[[:punct:]]\|[[:punct:]]'; then
            # Punctuation-pipe-punctuation patterns
            return 0
        fi
        
        # Check for pipe at the very beginning or end with special chars
        case "$cmd" in
            \|[^a-zA-Z0-9\ ]*|*[^a-zA-Z0-9\ ]\|)
                # Pipe at start/end with non-alphanumeric chars
                return 0
                ;;
        esac

        # ADDED: Control for backslash at end (incomplete escape)
        case "$cmd" in
            "\\")
                return 0
                ;;
            *"\\")
                # Check if it's a backslash at the very end
                if [ "${cmd#${cmd%?}}" = "\\" ]; then
                    return 0
                fi
                ;;
        esac
        
        case "$cmd" in
            "|"|*" |"|*"|") 
                return 0
                ;;
            "&&"|*" &&"|*"&& ") 
                return 0
                ;;
            "||"|*" ||"|*"|| ") 
                return 0
                ;;
        esac
        
        if echo "$cmd" | grep -qE '&{3,}'; then
            return 0
        fi
        
        return 1
    }

    ghostshell() {
        CURRENT_DIR=$(ghostroot -c toybox pwd -L 2>/dev/null)
        [ -z "$CURRENT_DIR" ] && CURRENT_DIR="/"
        
        while :; do
            if [ -z "$INIT_DONE" ]; then
                GETPROP=$(getprop ro.product.device)
                GHOST_PS1=$(ghostroot -c 'echo $PS1')
                echo "Welcome to the ghostroot shell (powered by cmd_skt root socket)\n"
                echo "Important!!!! Be careful with what you insert into the prompt because the script and the cli-pie might crash or hang, i don't know if I forgot some pattern so keep attention. If using -c is highly reccomended to wrap commands inside quotes. Use help to see the usage options.\n"
                export INIT_DONE=1
            fi
            
            printf "$GETPROP:$CURRENT_DIR $GHOST_PS1 "
            read -r CMD
            
            [ "$CMD" = "q" ] && echo "ghostroot shell provided by the Elite x Skorpion96" && exit 1
            [ "$CMD" = "exit" ] && echo exit > "$BR_IN" && echo "The ghostroot will now exit as the rootbridge.sh got closed." && exit 1
            
            [ -n "$CMD" ] || continue

            if [ "$CMD" = "help" ]; then
                usage
                continue
            fi
            
            if is_dangerous_command "$CMD"; then
                echo "We don't do that here."
                continue
            fi
            
            echo "$CMD" > "$BR_IN"
            sleep 0.2
            cat "$BR_OUT"
            
            case "$CMD" in
                cd|cd*)
                    out=$(ghostroot -c toybox pwd -L 2>/dev/null)
                    [ -n "$out" ] && CURRENT_DIR="$out"
                    ;;
            esac
        done
    }

   # If no args, start shell
   [ $# -eq 0 ] && ghostshell

# Handle -c mode
    if [ "$1" = "-c" ]; then
      shift
      
      if [ $# -eq 0 ]; then
          echo "Error: -c requires a command argument"
          usage
      fi
      
      CMD=""
      for arg in "$@"; do
          if [ -z "$CMD" ]; then
              CMD="$arg"
          else
              CMD="$CMD $arg"
          fi
      done
      
      if [ -z "$CMD" ] || [ "$CMD" = " " ]; then
          echo "Error: empty command provided"
          exit 1
      fi

      if [ "$CMD" = "help" ]; then
          usage
          exit 0
      fi

      # ENHANCED PIPE VALIDATION for -c mode
      if echo "$CMD" | grep -qE '\|[^a-zA-Z0-9 ]'; then
          # Pipe followed by special characters
          echo "We don't do that here."
          exit 1
      fi
      
      if echo "$CMD" | grep -qE '[^a-zA-Z0-9 ]\|'; then
          # Special characters followed by pipe
          echo "We don't do that here."
          exit 1
      fi
      
      if echo "$CMD" | grep -qE '\|{3,}'; then
          # Three or more consecutive pipes
          echo "We don't do that here."
          exit 1
      fi
      
      if echo "$CMD" | grep -qE '[[:punct:]]\|[[:punct:]]'; then
          # Punctuation-pipe-punctuation patterns
          echo "We don't do that here."
          exit 1
      fi
      
      case "$CMD" in
          \|[^a-zA-Z0-9\ ]*|*[^a-zA-Z0-9\ ]\|)
              # Pipe at start/end with non-alphanumeric chars
              echo "We don't do that here."
              exit 1
              ;;
      esac

      # SEMICOLON + COMMAND INJECTION CHECK for -c mode
      if echo "$CMD" | grep -qE ';[a-zA-Z0-9]'; then
          # Patterns like ;id ;whoami ;cat etc.
          echo "We don't do that here."
          exit 1
      fi

      # SEMICOLON + REDIRECT VALIDATION for -c mode
      if echo "$CMD" | grep -qE ';[<>]'; then
          # Patterns like ;> ;< ;<< ;>> etc.
          echo "We don't do that here."
          exit 1
      fi
      
      if echo "$CMD" | grep -qE '[<>];'; then
          # Patterns like >; <; >>; <<; etc.
          echo "We don't do that here."
          exit 1
      fi
      
      if echo "$CMD" | grep -qE '([<>];|;[<>]){2,}'; then
          # Multiple occurrences of these patterns
          echo "We don't do that here."
          exit 1
      fi
      
      # IMPROVED SECURITY CHECKS for -c mode
      case "$CMD" in
          *\`*|*'$('*|*'${'*|*'$(('*)
              echo "We don't do that here."
              exit 1
              ;;
      esac
      
      # SEMICOLON VALIDATION for -c mode (matching the function)
      case "$CMD" in
          ";")
              # Isolated semicolon - dangerous
              echo "We don't do that here."
              exit 1
              ;;
          *" ; "*|*" ;"*)
              # Only block specific suspicious patterns
              echo "We don't do that here."
              exit 1
              ;;
          *";;"*)
              # Double semicolon - dangerous
              echo "We don't do that here."
              exit 1
              ;;
      esac
      
      # ADDED: Check for semicolon with dots patterns in -c mode
      if echo "$CMD" | grep -qE '(;\.+|\.+;)'; then
          # Patterns like ;. .; ...; ;.. etc.
          echo "We don't do that here."
          exit 1
      fi
      
      # ADDED: Check for multiple consecutive dots
      if echo "$CMD" | grep -qE '\.{3,}'; then
          # Three or more consecutive dots (potential traversal)
          echo "We don't do that here."
          exit 1
      fi
      
      # ADDED: Check for semicolon followed by space and special chars
      if echo "$CMD" | grep -qE '; [\.!/\\\]'; then
          # Semicolon followed by space and dangerous chars
          echo "We don't do that here."
          exit 1
      fi
      
      # ADDED: Check for isolated or trailing backslashes (incomplete escapes)
      case "$CMD" in
          "\\")
              echo "We don't do that here."
              exit 1
              ;;
          *"\\")
              if [ "${CMD#${CMD%?}}" = "\\" ]; then
                  echo "We don't do that here."
                  exit 1
              fi
              ;;
      esac
      
      # ADDED: Check for unbalanced single quotes
      single_quotes_count=$(echo "$CMD" | tr -cd "'" | wc -c)
      if [ $((single_quotes_count % 2)) -ne 0 ]; then
          echo "We don't do that here."
          exit 1
      fi
      
      # ADDED: Check for unbalanced double quotes
      double_quotes_count=$(echo "$CMD" | tr -cd '"' | wc -c)
      if [ $((double_quotes_count % 2)) -ne 0 ]; then
          echo "We don't do that here."
          exit 1
      fi

      # ADDED: Check for three or more consecutive quotes (injection attempt)
      if printf '%s\n' "$CMD" | grep -q "'''"; then
          # Three or more consecutive single quotes
          echo "We don't do that here."
          exit 1
      fi
      
      if printf '%s\n' "$CMD" | grep -q '"""'; then
          # Three or more consecutive double quotes
          echo "We don't do that here."
          exit 1
      fi
      
      # ADDED: Check for unbalanced parentheses
      paren_open=$(echo "$CMD" | tr -cd '(' | wc -c)
      paren_close=$(echo "$CMD" | tr -cd ')' | wc -c)
      if [ "$paren_open" -ne "$paren_close" ]; then
          echo "We don't do that here."
          exit 1
      fi
      
      # ADDED: Check for unbalanced braces
      brace_open=$(echo "$CMD" | tr -cd '{' | wc -c) 
      brace_close=$(echo "$CMD" | tr -cd '}' | wc -c)
      if [ "$brace_open" -ne "$brace_close" ]; then
          echo "We don't do that here."
          exit 1
      fi
      
      # ADDED: Check for unbalanced square brackets
      bracket_open=$(echo "$CMD" | tr -cd '[' | wc -c)
      bracket_close=$(echo "$CMD" | tr -cd ']' | wc -c)
      if [ "$bracket_open" -ne "$bracket_close" ]; then
          echo "We don't do that here."
          exit 1
      fi
      
      # ADDED: Check for ANSI escape sequences (POSIX compatible)
      case "$CMD" in
          *"\\033"*|*"\\x1b"*|*"\\e"*)
              echo "We don't do that here."
              exit 1
              ;;
      esac
      
      # ADDED: Check for real ESC character (ASCII 27)
      if printf '%s' "$CMD" | grep -q "$(printf '\033')"; then
          echo "We don't do that here."
          exit 1
      fi
      
      if is_dangerous_command "$CMD"; then
          echo "We don't do that here."
          exit 1
      fi
      
      printf '%s\n' "$CMD" > "$BR_IN"
      sleep 0.2
      cat "$BR_OUT"
    else
      usage
    fi
}

# --- Service check before running main() ---
SERVICE_STATE="$(getprop init.svc.cmd_services)"
if [ "$SERVICE_STATE" != "running" ]; then
    echo "Error: cmd_services not running."
    echo "Please start it before running this script."
    exit 1
fi

# --- Ping–response check ---
BR_IN="/sdcard/rootbridge/in/command.txt"
BR_OUT="/sdcard/rootbridge/out/result.txt"
PING_TOKEN="GR_PING_$$"

# Clear any old output
> "$BR_OUT"

# Send ping
echo "echo $PING_TOKEN" > "$BR_IN"

# Wait for up to 2 seconds for correct reply
timeout=20  # 20 × 0.1s = 2 seconds
while [ $timeout -gt 0 ]; do
    if grep -q "$PING_TOKEN" "$BR_OUT"; then
        break
    fi
    sleep 0.1
    timeout=$((timeout - 1))
done

if [ $timeout -eq 0 ]; then
    echo "Error: rootbridge is not responding."
    echo "Please start rootbridge before running this script."
    exit 1
fi

main "$@"
