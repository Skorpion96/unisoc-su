                echo "Important!!!! Be careful with what you insert into the prompt because the script and the cli-pie might crash or hang, i don't know if I forgot some pattern so keep attention. If using -c is highly reccomended to wrap commands inside quotes. Use help to see the usage options.\n"
                export INIT_DONE=1
            fi
            
            printf "$GETPROP:$CURRENT_DIR $GHOST_PS1 "
            read -r CMD
            
            [ "$CMD" = "q" ] && echo "ghostroot shell provided by the Elite x Skorpion96" && exit 1
