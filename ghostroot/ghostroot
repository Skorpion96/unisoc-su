#!/system/bin/sh

main() {
    BR_IN="/sdcard/rootbridge/in/command.txt"
    BR_OUT="/sdcard/rootbridge/out/result.txt"
    BANNED_CMDS=(if fi else elif then while do done for until case esac select in function continue break logout return trap unset)
    BANNED_PATTERNS=("'" '"' ":" ";" "{" "}" "[" "]" ";;" "''" '""')

    ghostshell() {
        CURRENT_DIR=$(ghostroot -c toybox pwd -L 2>/dev/null)
        [ -z "$CURRENT_DIR" ] && CURRENT_DIR="/"
        while :; do
        if [ -z "$INIT_DONE" ]; then
        GETPROP=$(getprop ro.product.device)
        GHOST_PS1=$(ghostroot -c 'echo $PS1')
        echo "Welcome to the ghostroot shell (powered by cmd_skt root socket)\n"
        echo "Important!!!! Do not insert \\ or ) or ( on the prompt because the script and the cli-pie will crash or hang, also do not mix patterns alone or with commands e.g echo 'id; (i don't know if I forgot some pattern so be careful)"
        export INIT_DONE=1
        fi
        printf "$GETPROP:$CURRENT_DIR $GHOST_PS1 "
        read CMD
        [ "$CMD" = "q" ] && echo "ghostroot shell provided by the Elite x Skorpion96" && exit 1
        [ "$CMD" = "exit" ] && echo exit > "$BR_IN" && echo "The ghostroot will now exit as the rootbridge.sh got closed." && exit 1
        CMD_NAME=$(printf "%s" "$CMD" | awk '{print $1}')
        if [[ "$CMD_NAME" == *=* ]]; then
        IS_ASSIGNMENT=1
        else
        IS_ASSIGNMENT=0
        fi
        if command -v "$CMD_NAME" >/dev/null 2>&1 || type "$CMD_NAME" >/dev/null 2>&1; then
        IS_REAL_CMD=1
        else
        IS_REAL_CMD=0
        fi
        for word in $CMD; do
        for banned in "${BANNED_CMDS[@]}"; do
        if [ "$word" = "$banned" ]; then
        echo "Obviously you don't want the script to act weird or to kill it with the cli-pie altogether so don't type this."
        ghostshell
        fi
        done
        done
        for banned in "${BANNED_PATTERNS[@]}"; do
        case "$CMD" in
        *"$banned"*)
        if [ "$IS_REAL_CMD" -eq 0 ] && [ "$IS_ASSIGNMENT" -eq 0 ]; then
        echo "Obviously you don't want the script to act weird or to kill it with the cli-pie altogether so don't type this."
        ghostshell
        fi
        ;;
        esac
        done
        [ -n "$CMD" ] || continue
        echo "$CMD" > "$BR_IN"
        sleep 0.2
        cat "$BR_OUT"
        out=$(ghostroot -c toybox pwd -L 2>/dev/null)
        case "$CMD" in
        cd|cd*)
        [ -n "$out" ] && CURRENT_DIR="$out"
        ;;
        esac
        done
        }

    usage() {
      cat <<EOF >&2
Usage:
  ghostroot -c <command>   # run a single root command
  ghostroot                # enter interactive ghostroot shell
  <exit>                     # exits the rootbridge.sh
  <q>                        # exits the ghostroot, you can always enter again and resume
EOF
      exit 1
    }

    # If no args, start shell
    [ $# -eq 0 ] && ghostshell

    # Handle -c mode
    if [ "$1" = "-c" ]; then
      shift
      [ $# -gt 0 ] || usage
      CMD="$*"
      printf '%s\n' "$CMD" > "$BR_IN"
      sleep 0.2
      cat "$BR_OUT"
    else
      usage
    fi
}

# --- Service check before running main() ---
SERVICE_STATE="$(getprop init.svc.cmd_services)"
if [ "$SERVICE_STATE" != "running" ]; then
    echo "Error: cmd_services not running."
    echo "Please start it before running this script."
    exit 1
fi

# --- Ping–response check ---
BR_IN="/sdcard/rootbridge/in/command.txt"
BR_OUT="/sdcard/rootbridge/out/result.txt"
PING_TOKEN="GR_PING_$$"

# Clear any old output
> "$BR_OUT"

# Send ping
echo "echo $PING_TOKEN" > "$BR_IN"

# Wait for up to 2 seconds for correct reply
timeout=20  # 20 × 0.1s = 2 seconds
while [ $timeout -gt 0 ]; do
    if grep -q "$PING_TOKEN" "$BR_OUT"; then
        break
    fi
    sleep 0.1
    timeout=$((timeout - 1))
done

if [ $timeout -eq 0 ]; then
    echo "Error: rootbridge is not responding."
    echo "Please start rootbridge before running this script."
    exit 1
fi

main "$@"
