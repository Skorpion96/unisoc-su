      fi

      # ADDED: Check for three or more consecutive quotes (injection attempt)
      if printf '%s\n' "$CMD" | grep -q "'''"; then
          # Three or more consecutive single quotes
          echo "We don't do that here."
          exit 1
      fi
      
      if printf '%s\n' "$CMD" | grep -q '"""'; then
          # Three or more consecutive double quotes
          echo "We don't do that here."
          exit 1
      fi
      
      # ADDED: Check for unbalanced parentheses
      paren_open=$(echo "$CMD" | tr -cd '(' | wc -c)
      paren_close=$(echo "$CMD" | tr -cd ')' | wc -c)
      if [ "$paren_open" -ne "$paren_close" ]; then
          echo "We don't do that here."
          exit 1
      fi
      
      # ADDED: Check for unbalanced braces
      brace_open=$(echo "$CMD" | tr -cd '{' | wc -c) 
      brace_close=$(echo "$CMD" | tr -cd '}' | wc -c)
      if [ "$brace_open" -ne "$brace_close" ]; then
          echo "We don't do that here."
          exit 1
      fi
      
      # ADDED: Check for unbalanced square brackets
      bracket_open=$(echo "$CMD" | tr -cd '[' | wc -c)
      bracket_close=$(echo "$CMD" | tr -cd ']' | wc -c)
      if [ "$bracket_open" -ne "$bracket_close" ]; then
          echo "We don't do that here."
          exit 1
      fi
      
      # ADDED: Check for ANSI escape sequences (POSIX compatible)
      case "$CMD" in
          *"\\033"*|*"\\x1b"*|*"\\e"*)
              echo "We don't do that here."
              exit 1
              ;;
      esac
      
      # ADDED: Check for real ESC character (ASCII 27)
      if printf '%s' "$CMD" | grep -q "$(printf '\033')"; then
          echo "We don't do that here."
          exit 1
      fi
      
      # NEW ENHANCED VALIDATIONS for -c mode - Call the same validation functions
      if validate_consecutive_patterns "$CMD"; then
          echo "We don't do that here."
          exit 1
      fi
      
      if validate_word_boundaries "$CMD"; then
          echo "We don't do that here."
          exit 1
      fi
      
      if validate_quotes_and_escapes "$CMD"; then
          echo "We don't do that here."
          exit 1
      fi
      
      if is_dangerous_command "$CMD"; then
          echo "We don't do that here."
          exit 1
      fi
      
      printf '%s\n' "$CMD" > "$BR_IN"
      sleep 0.2
      cat "$BR_OUT"
    else
      usage
    fi
}

# --- Initialize and validate system only once ---
init_system_checks() {
    # Service check
    SERVICE_STATE="$(getprop init.svc.cmd_services)"
    if [ "$SERVICE_STATE" != "running" ]; then
        echo "Error: cmd_services not running."
        echo "Please start it before running this script."
        exit 1
    fi

    # Ping–response check
    BR_IN="/sdcard/rootbridge/in/command.txt"
    BR_OUT="/sdcard/rootbridge/out/result.txt"
    PING_TOKEN="GR_PING_$$"

    # Clear any old output
    > "$BR_OUT"

    # Send ping
    echo "echo $PING_TOKEN" > "$BR_IN"

    # Wait for up to 2 seconds for correct reply
    timeout=20  # 20 × 0.1s = 2 seconds
    while [ $timeout -gt 0 ]; do
        if grep -q "$PING_TOKEN" "$BR_OUT"; then
            export SYSTEM_INIT_DONE=1
            return 0
        fi
        sleep 0.1
        timeout=$((timeout - 1))
    done

    # If we reach here, ping failed
    echo "Error: rootbridge is not responding."
    echo "Please start rootbridge before running this script."
    exit 1
}

# Only run system checks once
if [ -z "$SYSTEM_INIT_DONE" ]; then
    init_system_checks
fi

main "$@"
