#!/system/bin/sh

main() {
    BR_IN="/sdcard/rootbridge/in/command.txt"
    BR_OUT="/sdcard/rootbridge/out/result.txt"
    BANNED_CMDS="if fi else elif then while do done for until case esac select in function continue break logout return trap unset"
    DANGEROUS_PATTERNS="\` <( >| &"

    usage() {
      cat <<EOF >&2
Usage:
  ghostroot -c <command>   # run a single root command
  ghostroot                # enter interactive ghostroot shell
  <exit>                   # exits the rootbridge.sh
  <q>                      # exits the ghostroot, you can always enter again and resume
  <help>                   # Show this help message
EOF
}

    # Function to handle exec commands safely
    handle_exec_command() {
        local cmd="$1"
        local is_c_mode="$2"
        
        # Extract the command after 'exec'
        local exec_cmd=$(echo "$cmd" | sed 's/^[[:space:]]*exec[[:space:]]*//')
        
        # If exec_cmd is empty, just run the original command (will likely show error)
        if [ -z "$exec_cmd" ]; then
            echo "$cmd" > "$BR_IN"
            sleep 0.2
            cat "$BR_OUT"
        else
            # Execute the command without exec
            echo "$exec_cmd" > "$BR_IN"
            sleep 0.2
            cat "$BR_OUT"
        fi
        
        # If in -c mode, exit normally. If in shell mode, continue the loop.
        if [ "$is_c_mode" = "true" ]; then
            return 0
        else
            return 1  # Continue shell loop
        fi
    }

    # Enhanced validation function for consecutive command patterns
    validate_consecutive_patterns() {
        local cmd="$1"
        
        # Check for && followed by banned keywords
        case "$cmd" in
            *"&& if"*|*"&& fi"*|*"&& else"*|*"&& elif"*|*"&& then"*|*"&& while"*|*"&& do"*|*"&& done"*|*"&& for"*|*"&& until"*|*"&& case"*|*"&& esac"*|*"&& select"*|*"&& function"*|*"&& continue"*|*"&& break"*|*"&& logout"*|*"&& return"*|*"&& trap"*|*"&& unset"*)
                return 0  # Dangerous
                ;;
        esac
        
        # Check for semicolon followed by banned keywords
        case "$cmd" in
            *"; if"*|*"; fi"*|*"; else"*|*"; elif"*|*"; then"*|*"; while"*|*"; do"*|*"; done"*|*"; for"*|*"; until"*|*"; case"*|*"; esac"*|*"; select"*|*"; function"*|*"; continue"*|*"; break"*|*"; logout"*|*"; return"*|*"; trap"*|*"; unset"*)
                return 0  # Dangerous
                ;;
        esac
        
        # Check for patterns like "id; ;" (command followed by semicolon space semicolon)
        if echo "$cmd" | grep -qE '[a-zA-Z0-9]; ;'; then
            return 0  # Dangerous
        fi
        
        # Check for multiple consecutive semicolons with any spacing
        if echo "$cmd" | grep -qE ';[[:space:]]*;[[:space:]]*;'; then
            return 0  # Dangerous (three or more semicolons)
        fi
        
        # Check for && followed by single character commands or suspicious patterns
        if echo "$cmd" | grep -qE '&&[[:space:]]*[a-zA-Z][[:space:]]*($|[;&|])'; then
            return 0  # Patterns like "id && i" or "cmd && x;"
        fi
        
        # Check for semicolon followed by control flow patterns
        if echo "$cmd" | grep -qE ';[[:space:]]*\{|;[[:space:]]*\}|;[[:space:]]*\(|;[[:space:]]*\)'; then
            return 0  # Patterns like "; {" or "; }"
        fi
        
        # Check for && followed by control flow patterns  
        if echo "$cmd" | grep -qE '&&[[:space:]]*\{|&&[[:space:]]*\}|&&[[:space:]]*\(|&&[[:space:]]*\)'; then
            return 0  # Patterns like "&& {" or "&& }"
        fi
        
        # Check for chained operators (combination of different operators)
        if echo "$cmd" | grep -qE '(&&.*[;&|]|;.*[&|]|\|.*[;&])'; then
            # Mixed operator chains can be dangerous
            # Allow simple cases like "cmd && cmd | grep" but block complex mixed chains
            if echo "$cmd" | grep -qE '(&&.*;|;.*&&|\|\|.*[;&]|[;&].*\|\|)'; then
                return 0  # Dangerous mixed chains
            fi
        fi
        
        return 1  # Safe
    }

    # Word boundary validation for better keyword detection
    validate_word_boundaries() {
        local cmd="$1"
        
        # More precise detection of banned keywords using word boundaries
        for banned in if fi else elif then while do done for until case esac select function continue break logout return trap unset; do
            # Check if banned word appears as a complete word after && or ;
            if echo "$cmd" | grep -qE "(&&|;)[[:space:]]+$banned([[:space:]]|$)"; then
                return 0  # Dangerous
            fi
            
            # Check if banned word appears at the start after && or ;
            if echo "$cmd" | grep -qE "(&&|;)$banned([[:space:]]|$)"; then
                return 0  # Dangerous  
            fi
        done
        
        return 1  # Safe
    }

    # Enhanced quote and escape validation
    validate_quotes_and_escapes() {
        local cmd="$1"
        
        # Check for quote injection patterns
        case "$cmd" in
            *"'"*"&&"*"'"*|*'"'*";"*"'"*)
                # Single quotes around operators
                return 0
                ;;
            *'"'*"&&"*'"'*|*'"'*";"*'"'*)
                # Double quotes around operators  
                return 0
                ;;
        esac
        
        # Check for escaped operator injection
        if echo "$cmd" | grep -qE '\\(&&|;|\|)'; then
            return 0  # Escaped operators
        fi
        
        # Check for hex/octal encoded operators
        if echo "$cmd" | grep -qE '\\x26\\x26|\\x3B|\\046\\046|\\073'; then
            return 0  # Hex/octal encoded && or ;
        fi
        
        return 1  # Safe
    }

    # Check if command starts with exec
    is_exec_command() {
        local cmd="$1"
        case "$cmd" in
            exec|exec\ *|exec$'\t'*)
                return 0  # Is exec command
                ;;
            *)
                return 1  # Not exec command
                ;;
        esac
    }

    is_dangerous_command() {
        cmd="$1"

        first_word=$(echo "$cmd" | awk '{print $1}' | cut -d'=' -f1)
        for banned in $BANNED_CMDS; do
        if echo "$first_word" | grep -qE "^$banned([^a-zA-Z0-9]|$)"; then
        return 0
        fi
        done
        
        case "$cmd" in
            *\`*|*"<("*|*">|"*|*">"|"<")
                return 0
                ;;
            *"&"*)
                case "$cmd" in
                    *"&>"*|*">&"*) 
                        # Allow redirect operators like &>, >&, 2>&1, etc.
                        ;;
                    *[0-9]">&"[0-9]*|*">&"[0-9]*|*[0-9]">&")
                        # Allow file descriptor redirections like 2>&1, 1>&2, >&2, 2>&
                        ;;
                    *"&&"*)
                        # Handle && validation separately below
                        ;;
                    *)
                        # Check for background process operator (&) at the end
                        if echo "$cmd" | grep -qE '[a-zA-Z0-9][[:space:]]*&[[:space:]]*$'; then
                            # Allow background processes like "command &"
                            :
                        else
                            return 0
                        fi
                        ;;
                esac
                ;;
        esac

        # ENHANCED && VALIDATION (replaces the old logic)
        case "$cmd" in
            "&&")
                # Isolated && - dangerous
                return 0
                ;;
            "&&"*)
                # Commands starting with && (like "&&id" or "&& id") - BLOCKED
                return 0
                ;;
            *"&&")
                # Commands ending with && (like "id&&" or "id &&") - BLOCKED
                return 0
                ;;
            *"&&"*)
                # Any command containing &&
                # Check if it's a legitimate command chain (command before AND after &&)
                if echo "$cmd" | grep -qE '[a-zA-Z0-9][[:space:]]*&&[[:space:]]*[a-zA-Z0-9]'; then
                    # This looks like a legitimate command chain (e.g., "id && whoami")
                    # Allow it to pass this check
                    :
                else
                    # Suspicious && usage
                    return 0
                fi
                ;;
        esac

        # Check for triple or more ampersands
        if echo "$cmd" | grep -qE '&{3,}'; then
            return 0
        fi
        
        paren_open=$(echo "$cmd" | tr -cd '(' | wc -c)
        paren_close=$(echo "$cmd" | tr -cd ')' | wc -c)
        brace_open=$(echo "$cmd" | tr -cd '{' | wc -c) 
        brace_close=$(echo "$cmd" | tr -cd '}' | wc -c)
        bracket_open=$(echo "$cmd" | tr -cd '[' | wc -c)
        bracket_close=$(echo "$cmd" | tr -cd ']' | wc -c)
        single_quotes=$(echo "$cmd" | tr -cd "'" | wc -c)
        double_quotes=$(echo "$cmd" | tr -cd '"' | wc -c)
        
        if [ "$paren_open" -ne "$paren_close" ]; then
            return 0
        fi
        if [ "$brace_open" -ne "$brace_close" ]; then
            return 0  
        fi
        if [ "$bracket_open" -ne "$bracket_close" ]; then
            return 0
        fi
        if [ $((single_quotes % 2)) -ne 0 ]; then
            return 0
        fi
        if [ $((double_quotes % 2)) -ne 0 ]; then
            return 0
        fi
        
        case "$cmd" in
            *'$(('*|*'))'*|*'$['*|*']'*|*'${#'*|*'${!'*|*'${'*)
                return 0 ;;
            *'&>'*|*'<<<'*)
                case "$cmd" in
                    *'<<<'*)
                        return 0
                        ;;
                esac
                ;;
        esac
        
        if echo "$cmd" | grep -q '[!]' && ! echo "$cmd" | grep -qE '(\$\([^\)]*\)|"[^"]*![^"]*")'; then
            return 0
        fi
        
        # MINIMAL SEMICOLON VALIDATION - Only block the most dangerous patterns
        case "$cmd" in
            ";")
                # Isolated semicolon - dangerous
                return 0
                ;;
            *";;"*)
                # Double semicolon - dangerous
                return 0
                ;;
        esac
        
        # Block semicolon directly followed by command (no space) - injection
        if echo "$cmd" | grep -qE ';[a-zA-Z0-9]'; then
            # Patterns like ;id ;whoami ;cat etc. (semicolon starting a command)
            return 0
        fi
        
        # Block dangerous semicolon patterns but allow legitimate ones
        case "$cmd" in
            "; "*) 
                # Commands starting with "; " (like "; id") - injection attempt
                return 0
                ;;
        esac
        
        # ADDED: Check for semicolon with dots patterns
        if echo "$cmd" | grep -qE '(;\.+|\.+;)'; then
            # Patterns like ;. .; ...; ;.. etc.
            return 0
        fi
        
        # ADDED: Check for multiple dots (potential directory traversal when combined with other chars)
        if echo "$cmd" | grep -qE '\.{3,}'; then
            # Three or more consecutive dots
            return 0
        fi
        
        # ADDED: Check for semicolon followed by space and special chars
        if echo "$cmd" | grep -qE '; [\.!/\\\]'; then
            # Semicolon followed by space and potentially dangerous chars
            return 0
        fi

        # SEMICOLON + REDIRECT VALIDATION
        # Check for semicolon followed by redirect operators
        if echo "$cmd" | grep -qE ';[<>]'; then
            # Patterns like ;> ;< ;<< ;>> etc.
            return 0
        fi
        
        # Check for redirect operators followed by semicolon
        if echo "$cmd" | grep -qE '[<>];'; then
            # Patterns like >; <; >>; <<; etc.
            return 0
        fi
        
        # Check for multiple redirect-semicolon combinations
        if echo "$cmd" | grep -qE '([<>];|;[<>]){2,}'; then
            # Multiple occurrences of these patterns
            return 0
        fi

      if echo "$CMD" | grep -qE '(><|<>|><<|>><<|<<>>|><<>)'; then
          return 0
      fi
        
      # ENHANCED PIPE VALIDATION
      # First check for legitimate || usage
      if echo "$CMD" | grep -qE '\|\|'; then
          # Contains ||, check if it's legitimate
          if echo "$CMD" | grep -qE '[a-zA-Z0-9][[:space:]]*\|\|[[:space:]]*[a-zA-Z0-9]'; then
              # Legitimate logical OR like "id || whoami" - allow it
              :
          else
              # Suspicious || usage
              case "$CMD" in
        "||"|*" ||"|*"|| "|"||*"|"||"*)
        return 0
        ;;
          esac
          fi
      else
          # No || present, apply regular pipe validation
          if echo "$CMD" | grep -qE '\|[^a-zA-Z0-9 ]'; then
              # Pipe followed by special characters
              return 0
          fi
          
          if echo "$CMD" | grep -qE '[^a-zA-Z0-9 ]\|'; then
              # Special characters followed by pipe
              return 0
          fi
      fi
      
      if echo "$CMD" | grep -qE '\|{3,}'; then
          # Three or more consecutive pipes
          return 0
      fi
      
      # Check for punctuation-pipe-punctuation but skip || patterns
      if echo "$CMD" | grep -qE '[[:punct:]]\|[[:punct:]]' && ! echo "$CMD" | grep -qE '\|\|'; then
          # Punctuation-pipe-punctuation patterns (but not ||)
          return 0
      fi
      
      case "$CMD" in
          \|[^a-zA-Z0-9\ ]*|*[^a-zA-Z0-9\ ]\|)
              # Skip if it's part of ||
              if ! echo "$CMD" | grep -qE '\|\|'; then
                  return 0
              fi
              ;;
      esac

        # ADDED: Control for backslash at end (incomplete escape)
        case "$cmd" in
            "\\")
                return 0
                ;;
            *"\\")
                # Check if it's a backslash at the very end
                if [ "${cmd#${cmd%?}}" = "\\" ]; then
                    return 0
                fi
                ;;
        esac
        
        case "$cmd" in
            "|"|*" |"|*"|") 
                return 0
                ;;
            "||"|*" ||"|*"|| ") 
                return 0
                ;;
        esac
        
        case "$cmd" in
            "<"|*" <"|*"<") 
                return 0
                ;;
            "<<"|*" <<"|*"<< ") 
                return 0
                ;;
        esac
        
        # Enhanced consecutive pattern validation
        if validate_consecutive_patterns "$cmd"; then
            return 0
        fi
        
        # Enhanced word boundary validation  
        if validate_word_boundaries "$cmd"; then
            return 0
        fi
        
        # Enhanced quote and escape validation
        if validate_quotes_and_escapes "$cmd"; then
            return 0
        fi

        #Check for mixed redirect patterns - but allow standard redirections
        if echo "$cmd" | grep -qE '(><|<>)'; then
            # Only block truly dangerous mixed redirects, not standard ones
            if ! echo "$cmd" | grep -qE '[0-9]?><[0-9]?|[0-9]?<>[0-9]?'; then
                return 0  # Dangerous - invalid mixed redirects
            fi
        fi
        
        # Check for banned keywords after pipe operators  
        for banned in $BANNED_CMDS; do
        if echo "$cmd" | grep -qE "\|[[:space:]]*$banned([[:space:]]|$)"; then
        return 0
        fi
        if echo "$cmd" | grep -qE "\|\|[[:space:]]*$banned([[:space:]]|$)"; then
        return 0  
        fi
        done

        return 1
    }

    ghostshell() {
